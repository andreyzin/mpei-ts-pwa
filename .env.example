VITE_API_URL=/api

# --- Telegram (backend and bot share the token) ---------------------------
TELEGRAM_BOT_TOKEN=
# Chat that receives feature suggestions; without it and the token
# POST /api/v1/suggestions answers 503.
SUGGESTIONS_CHAT_ID=
# A local Bot API server (telegram-bot-api), e.g. http://localhost:8081.
# Empty means api.telegram.org.
TELEGRAM_API_BASE=

# Shared secret for services of this deployment (the bot): requests carrying it
# as X-Internal-Token skip the backend's per-address rate limit.
INTERNAL_API_TOKEN=

# --- Bot ------------------------------------------------------------------
# Public address of the web app; lesson messages link to the day there.
APP_URL=
# Empty or http://localhost...: long polling. https://...: webhook, which then
# needs WEBHOOK_SECRET and the bot's port 8080 reachable at that address.
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=

# --- Postgres (bot and Umami) ---------------------------------------------
POSTGRES_USER=mpei
POSTGRES_PASSWORD=mpei

# --- Analytics --------------------------------------------------------------
UMAMI_APP_SECRET=
# Umami tracker and the website id from its dashboard. Empty keeps analytics
# and the consent banner off.
VITE_UMAMI_SCRIPT_URL=http://localhost:3000/script.js
VITE_UMAMI_WEBSITE_ID=
