VITE_API_URL=/api

# Backend: feature suggestions are sent to this Telegram chat by the bot.
# Without both values POST /api/v1/suggestions answers 503.
TELEGRAM_BOT_TOKEN=
SUGGESTIONS_CHAT_ID=
# A local Bot API server (telegram-bot-api) instead of api.telegram.org.
TELEGRAM_API_BASE=https://api.telegram.org

# Shared secret for services of this deployment (the bot): requests carrying it
# as X-Internal-Token skip the backend's per-address rate limit.
INTERNAL_API_TOKEN=
